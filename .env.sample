# BOTH DOCKER OR STANDALONE
ARCADESCORE_HTTP_PORT=8080

# Optional. Set to "1" to enable Flask/Werkzeug debug mode (verbose tracebacks in
# the browser). Leave unset/"0" for normal use.
# ARCADESCORE_DEBUG=0

# Optional. Signs admin login sessions. If unset, a random key is generated once
# and persisted to data/secret_key so restarts don't log everyone out. Only set
# this yourself if you need sessions to survive wiping the data/ folder.
# SECRET_KEY=

# UPDATER (see app/modules/updater.py) - both optional, for local testing only.
# Leave unset in normal use; the real app checks github.com/mikedmor/ArcadeScore.
#
# Point the update checker at a different "owner/repo" - e.g. a disposable test repo
# with fake integer-tagged releases (some marked pre-release) - to exercise the real
# GitHub API path without ever touching the real project's releases.
# ARCADESCORE_UPDATE_REPO=your-username/arcadescore-test
#
# Skip the network entirely and read a local JSON file instead (shaped like GitHub's
# release-list response: an array of {tag_name, prerelease, draft, published_at,
# html_url}). Fastest test loop, fully offline. Takes priority over
# ARCADESCORE_UPDATE_REPO if both are set.
# ARCADESCORE_UPDATE_FEED_OVERRIDE=./data/fake_releases.json

# WEBHOOK SETUP
SERVER_HOST_IP=192.168.x.x # Ensure this is static

# REQUIRED FOR DOCKER
## NGINX SERVER
SERVER_NAME="localhost"
SSL_PEM=selfsigned.pem
SSL_KEY=selfsigned.key

## DOCKER MOUNTS
DOCKER_HTTP_PORT=80
DOCKER_HTTPS_PORT=443